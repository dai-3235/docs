---
import Base from '../../layouts/Base.astro';
import { publishedPosts, readingMinutes, formatDate, tagCounts, tagSlug } from '../../lib/blog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await publishedPosts();
const [featured, ...rest] = posts;
const tags = tagCounts(posts);
---

<Base title="Blog · Engineering Notes" description="Technical write-ups and the occasional personal note.">
  <div class="blog-wrap">
    <header class="blog-head">
      <span class="tag">Blog</span>
      <h1>Notes from building things</h1>
      <p>Technical write-ups and the occasional personal note. <a href={`${base}/rss.xml`}>RSS</a></p>
    </header>

    {featured && (
      <a class="featured" href={`${base}/blog/${featured.id}/`}>
        <span class="tag">Latest · {featured.data.kind}</span>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <span class="meta">{formatDate(featured.data.pubDate)} · {readingMinutes(featured)} min read</span>
      </a>
    )}

    {rest.length > 0 && (
      <div class="filters" role="group" aria-label="Filter posts">
        <button type="button" data-kind="all" aria-pressed="true">All</button>
        <button type="button" data-kind="technical" aria-pressed="false">Technical</button>
        <button type="button" data-kind="personal" aria-pressed="false">Personal</button>
      </div>
    )}

    {tags.length > 0 && (
      <div class="topics">
        {tags.map(([tag, count]) => (
          <a href={`${base}/blog/tags/${tagSlug(tag)}/`}>#{tag} <small>{count}</small></a>
        ))}
      </div>
    )}

    {rest.length > 0 && (
      <ul class="post-grid">
        {rest.map((p) => (
          <li data-kind={p.data.kind}>
            <a href={`${base}/blog/${p.id}/`}>
              <span class="tag">{p.data.kind}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="meta">{formatDate(p.data.pubDate)} · {readingMinutes(p)} min read</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  <script is:inline>
    const buttons = document.querySelectorAll('.filters button');
    const items = document.querySelectorAll('.post-grid li');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        items.forEach((item) => {
          item.hidden = button.dataset.kind !== 'all' && item.dataset.kind !== button.dataset.kind;
        });
      });
    });
  </script>
</Base>
