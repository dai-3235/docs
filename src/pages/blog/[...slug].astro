---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, readingMinutes, formatDate, tagSlug } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title={`${post.data.title} · Engineering Notes`}
  description={post.data.description}
  image={`${base}/og/${post.id}.png`}
  type="article"
  published={post.data.pubDate}
>
  <div class="post-layout">
    <article class="article">
      <a class="meta" href={`${base}/blog/`}>← All posts</a>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="meta">
        {formatDate(post.data.pubDate, 'long')} · <span data-reading>{readingMinutes(post)} min read</span> · {post.data.kind}
      </p>
      {post.data.tags.length > 0 && (
        <p class="topics">
          {post.data.tags.map((tag) => <a href={`${base}/blog/tags/${tagSlug(tag)}/`}>#{tag}</a>)}
        </p>
      )}
      <div class="prose">
        <Content />
      </div>
      {(newer || older) && (
        <nav class="prevnext" aria-label="More posts">
          {older ? <a href={`${base}/blog/${older.id}/`}><small>Older</small>{older.data.title}</a> : <span />}
          {newer ? <a class="next" href={`${base}/blog/${newer.id}/`}><small>Newer</small>{newer.data.title}</a> : <span />}
        </nav>
      )}
    </article>
    <aside class="toc" aria-label="On this page">
      <div data-toc><strong>On this page</strong></div>
    </aside>
  </div>
</Base>
