---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Workflow from '../components/workflow/Workflow';
import { taskFlow } from '../data/workflows';
import { tagCounts, tagSlug, publishedPosts, readingMinutes, formatDate } from '../lib/blog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await publishedPosts();
const posts = all.slice(0, 5);
const tags = tagCounts(all).slice(0, 8);

const cards = [
  {
    tag: 'System design',
    title: 'Architecture you can defend',
    text: 'Requirements, flows, trade-offs, threat model and a team-scale version, written like an interview answer.',
    href: `${base}/slack-relay/system-design/`,
    icon: 'lucide:network',
  },
  {
    tag: 'Runbook',
    title: 'Operate it at 3 a.m.',
    text: 'Health checks, restart commands, token rotation and a troubleshooting table that says what to do next.',
    href: `${base}/slack-relay/runbook/`,
    icon: 'lucide:clipboard-list',
  },
  {
    tag: 'Guide',
    title: 'Set it up in minutes',
    text: 'Install the plugin, create the Slack app and keep it running for 24 hours on a Mac mini.',
    href: `${base}/slack-relay/setup/`,
    icon: 'lucide:rocket',
  },
];
---

<Base title="Engineering Notes">
  <section class="hero">
    <span class="eyebrow" data-reveal><span class="dot"></span>simple · lean · scale on demand</span>
    <h1 data-reveal>Efficient, practical <span class="gradient">engineering</span></h1>
    <p>
      System designs, runbooks and posts that start with the simplest thing that works, stay small, and
      grow only when the load asks for it.
    </p>
    <div class="actions">
      <a class="btn primary" href={`${base}/slack-relay/overview/`}>Start with slack-relay</a>
      <button type="button" class="btn" data-search-open>Search <kbd>⌘K</kbd></button>
    </div>
    <div class="principles">
      <div><strong>Simple</strong><span>The smallest design that meets today's requirement.</span></div>
      <div><strong>Lean</strong><span>Few moving parts, each one earning its place.</span></div>
      <div><strong>Scale on demand</strong><span>Say what triggers the next step, then build it only then.</span></div>
    </div>
  </section>

  <section class="section">
    <h2>Start here</h2>
    <div class="cards">
      {cards.map((c) => (
        <a class="card" data-reveal href={c.href}>
          <span class="icon"><Icon name={c.icon} size={20} /></span>
          <span class="tag">{c.tag}</span>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </a>
      ))}
    </div>

    <h2>Featured system</h2>
    <div class="showcase">
      <div>
        <span class="tag">slack-relay</span>
        <h3>Drive a coding agent from your phone</h3>
        <p>
          A chat message becomes a task for an agent running on your own machine. Outbound polling means nothing
          listens on a port, an allowlist is the trust boundary, and risky actions wait for an explicit yes.
        </p>
        <div class="actions">
          <a class="btn primary" href={`${base}/slack-relay/system-design/`}>Read the design</a>
          <a class="btn" href={`${base}/slack-relay/overview/`}>Overview</a>
        </div>
      </div>
      <div class="flow-wrap">
        <Workflow client:visible flow={taskFlow} title="Task flow" height={360} />
      </div>
    </div>

    {posts.length > 0 && (
      <>
        <h2>Latest from the blog</h2>
        <ul class="post-list">
          {posts.map((p) => (
            <li data-reveal>
              <a href={`${base}/blog/${p.id}/`}>
                <span>{p.data.title}</span>
                <time datetime={p.data.pubDate.toISOString()}>
                  {formatDate(p.data.pubDate)} · {readingMinutes(p)} min
                </time>
              </a>
            </li>
          ))}
        </ul>
        {tags.length > 0 && (
          <div class="topics" style="margin-top:1.2rem">
            {tags.map(([tag, count]) => <a href={`${base}/blog/tags/${tagSlug(tag)}/`}>#{tag} <small>{count}</small></a>)}
          </div>
        )}
      </>
    )}
  </section>
</Base>
