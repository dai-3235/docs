---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<button type="button" class="search-trigger" data-search-open aria-label="Search">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <span class="search-label">Search</span>
  <kbd class="search-kbd">⌘K</kbd>
</button>

<dialog class="search-dialog" data-base={base} aria-label="Search">
  <div class="search-panel">
    <div class="search-field">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input type="search" class="search-input" placeholder="Search by keyword or by meaning" autocomplete="off" spellcheck="false" />
      <button type="button" class="search-close" aria-label="Close">esc</button>
    </div>
    <div class="search-scopes" role="group" aria-label="Scope">
      <button type="button" data-kind="all" aria-pressed="true">All</button>
      <button type="button" data-kind="doc" aria-pressed="false">Docs</button>
      <button type="button" data-kind="blog" aria-pressed="false">Blog</button>
    </div>
    <div class="search-banner"></div>
    <ul class="search-results" role="listbox"></ul>
    <div class="search-empty"></div>
    <div class="search-footer">
      <span class="search-hints"><kbd>↑</kbd><kbd>↓</kbd> move <kbd>↵</kbd> open <kbd>tab</kbd> similar</span>
      <span class="search-status" aria-live="polite"></span>
    </div>
  </div>
</dialog>

<script>
  import { createEngine, type Hit, type Kind, type Status } from '../search/engine';

  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const input = dialog.querySelector<HTMLInputElement>('.search-input')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-results')!;
  const empty = dialog.querySelector<HTMLDivElement>('.search-empty')!;
  const statusEl = dialog.querySelector<HTMLSpanElement>('.search-status')!;
  const banner = dialog.querySelector<HTMLDivElement>('.search-banner')!;
  const scopes = dialog.querySelectorAll<HTMLButtonElement>('.search-scopes button');
  const engine = createEngine(dialog.dataset.base ?? '');
  const ignored = new Set(['the', 'and', 'for', 'how', 'does', 'from', 'with', 'that', 'this', 'what', 'when', 'can']);
  const suggestions = ['how does it work', 'keep it running', 'security risks', 'compare alternatives'];
  const RECENT_KEY = 'search-recent';

  let kind: Kind = 'all';
  let hits: Hit[] = [];
  let active = 0;
  let timer: number | undefined;
  let token = 0;
  let similarTo: Hit | null = null;

  const escapeHtml = (text: string) =>
    text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function recent(): string[] {
    try {
      return JSON.parse(localStorage.getItem(RECENT_KEY) ?? '[]');
    } catch {
      return [];
    }
  }

  function remember(query: string) {
    const q = query.trim();
    if (q.length < 3) return;
    const next = [q, ...recent().filter((r) => r !== q)].slice(0, 5);
    localStorage.setItem(RECENT_KEY, JSON.stringify(next));
  }

  function highlight(text: string, terms: string[]) {
    const safe = escapeHtml(text);
    const words = [...new Set(terms.map((t) => t.toLowerCase()).filter((t) => t.length > 2 && !ignored.has(t)))];
    if (!words.length) return safe;
    const escape = (w: string) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const pattern = new RegExp(`\\b(${words.map((w) => (w.length <= 3 ? `${escape(w)}\\b` : escape(w))).join('|')})`, 'gi');
    return safe.replace(pattern, '<mark>$1</mark>');
  }

  function excerpt(text: string, terms: string[]) {
    const lower = text.toLowerCase();
    let at = -1;
    for (const term of terms) {
      if (term.length < 3) continue;
      const found = lower.indexOf(term.toLowerCase());
      if (found >= 0 && (at < 0 || found < at)) at = found;
    }
    const start = Math.max(0, at - 60);
    const slice = text.slice(start, start + 190);
    return `${start > 0 ? '…' : ''}${slice}${start + 190 < text.length ? '…' : ''}`;
  }

  function renderStatus(s: Status) {
    if (s.keyword === 'error') statusEl.textContent = 'Search index unavailable';
    else if (s.semantic === 'ready') statusEl.textContent = 'Hybrid: keyword + meaning';
    else if (s.semantic === 'loading') statusEl.textContent = `Loading meaning model ${s.progress}%`;
    else if (s.semantic === 'unavailable') statusEl.textContent = 'Keyword search';
    else if (s.semantic === 'error') statusEl.textContent = 'Keyword search (model failed to load)';
    else statusEl.textContent = s.keyword === 'ready' ? 'Keyword search' : 'Loading…';
  }

  function setActive(index: number) {
    const items = list.querySelectorAll<HTMLLIElement>('li');
    if (!items.length) return;
    active = (index + items.length) % items.length;
    items.forEach((item, i) => item.setAttribute('aria-selected', String(i === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  }

  function chips(items: string[], attr: string) {
    return items.map((s) => `<button type="button" ${attr}="${escapeHtml(s)}">${escapeHtml(s)}</button>`).join('');
  }

  function renderHome() {
    list.innerHTML = '';
    banner.innerHTML = '';
    const past = recent();
    empty.innerHTML = `${past.length ? `<p>Recent</p><div class="search-suggest">${chips(past, 'data-suggest')}</div>` : ''}<p>Try a question, not just a keyword.</p><div class="search-suggest">${chips(suggestions, 'data-suggest')}</div>`;
  }

  function matchChip(hit: Hit) {
    const label = hit.match === 'both' ? 'keyword + meaning' : hit.match === 'meaning' ? 'by meaning' : 'keyword';
    return `<span class="search-match ${hit.match}">${label}</span>`;
  }

  function render(query: string) {
    const queryTerms = query.toLowerCase().split(/\W+/).filter(Boolean);
    banner.innerHTML = similarTo
      ? `<button type="button" class="search-back" data-back>← Back</button><span>Similar to <strong>${escapeHtml(similarTo.title)}${similarTo.section ? ` › ${escapeHtml(similarTo.section)}` : ''}</strong></span>`
      : '';
    if (!hits.length) {
      list.innerHTML = '';
      empty.innerHTML = similarTo ? '<p>Nothing similar enough.</p>' : `<p>No results for <strong>${escapeHtml(query)}</strong>.</p>`;
      return;
    }
    empty.innerHTML = '';
    list.innerHTML = hits
      .map((hit, i) => {
        const terms = similarTo ? [] : [...queryTerms, ...hit.terms];
        return `<li role="option" aria-selected="${i === 0}" data-url="${escapeHtml(hit.url)}" data-id="${hit.id}">
          <div class="search-row"><span class="search-kind">${hit.kind === 'blog' ? 'Blog' : 'Docs'}</span>
          <span class="search-title">${highlight(hit.title, terms)}</span>
          <span class="search-rel" title="Relevance ${Math.round(hit.score * 100)}%"><i style="width:${Math.max(8, Math.round(hit.score * 100))}%"></i></span></div>
          ${hit.section ? `<div class="search-section">${highlight(hit.section, terms)}</div>` : ''}
          <div class="search-snippet">${highlight(excerpt(hit.snippet, terms), terms)}</div>
          <div class="search-meta">${similarTo ? '' : matchChip(hit)}<button type="button" class="search-similar" data-similar="${hit.id}">Find similar</button></div>
        </li>`;
      })
      .join('');
    active = 0;
  }

  async function run() {
    const query = input.value.trim();
    const mine = ++token;
    similarTo = null;
    if (!query) {
      hits = [];
      renderHome();
      return;
    }
    if (query.length >= 2) engine.loadModel();
    try {
      const found = await engine.search(query, kind);
      if (mine !== token) return;
      hits = found;
      render(query);
    } catch {
      empty.innerHTML = '<p>The search index could not be loaded.</p>';
    }
  }

  async function showSimilar(id: number) {
    const source = hits.find((h) => h.id === id) ?? null;
    if (!source) return;
    const mine = ++token;
    const found = await engine.similar(id, kind);
    if (mine !== token) return;
    similarTo = source;
    hits = found;
    render(input.value);
  }

  function open(query?: string) {
    if (!dialog.open) dialog.showModal();
    if (query !== undefined) input.value = query;
    input.focus();
    input.select();
    renderStatus(engine.status());
    engine.loadKeyword().then(() => engine.loadVectors()).catch(() => undefined);
    if (input.value.trim()) run();
    else renderHome();
  }

  function go(url: string) {
    remember(input.value);
    dialog.close();
    window.location.href = url;
  }

  engine.subscribe((s) => {
    renderStatus(s);
    if (s.semantic === 'ready' && input.value.trim() && !similarTo) run();
  });

  document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', () => open()));
  document.querySelectorAll<HTMLElement>('[data-search-query]').forEach((el) =>
    el.addEventListener('click', () => open(el.dataset.searchQuery)),
  );

  document.addEventListener('keydown', (event) => {
    const typing = ['INPUT', 'TEXTAREA'].includes((event.target as HTMLElement)?.tagName);
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      open();
    } else if (event.key === '/' && !typing && !dialog.open) {
      event.preventDefault();
      open();
    }
  });

  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setActive(active + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setActive(active - 1);
    } else if (event.key === 'Enter') {
      const item = list.querySelectorAll<HTMLLIElement>('li')[active];
      if (item?.dataset.url) go(item.dataset.url);
    } else if (event.key === 'Tab' && event.shiftKey === false && document.activeElement === input) {
      const item = list.querySelectorAll<HTMLLIElement>('li')[active];
      if (item?.dataset.id) {
        event.preventDefault();
        showSimilar(Number(item.dataset.id));
      }
    }
  });

  dialog.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === dialog || target.closest('.search-close')) {
      dialog.close();
      return;
    }
    const suggest = target.closest<HTMLElement>('[data-suggest]');
    if (suggest) {
      input.value = suggest.dataset.suggest ?? '';
      run();
      return;
    }
    if (target.closest('[data-back]')) {
      run();
      return;
    }
    const similar = target.closest<HTMLElement>('[data-similar]');
    if (similar) {
      event.stopPropagation();
      showSimilar(Number(similar.dataset.similar));
      return;
    }
    const item = target.closest<HTMLLIElement>('li[data-url]');
    if (item?.dataset.url) go(item.dataset.url);
  });

  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(run, 90);
  });

  scopes.forEach((button) =>
    button.addEventListener('click', () => {
      kind = (button.dataset.kind as Kind) ?? 'all';
      scopes.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      run();
    }),
  );
</script>

<style is:global>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 2.4rem;
    padding: 0 0.7rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-elevated);
    color: var(--text-dim);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .search-trigger:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .search-kbd,
  .search-panel kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg);
    color: var(--text-dim);
  }

  .search-trigger .search-label {
    min-width: 7rem;
    text-align: left;
  }

  @media (max-width: 720px) {
    .search-trigger {
      width: 2.4rem;
      justify-content: center;
      padding: 0;
    }
    .search-trigger .search-label,
    .search-trigger .search-kbd {
      display: none;
    }
  }

  .search-dialog {
    width: min(42rem, calc(100vw - 1.5rem));
    max-height: min(36rem, calc(100vh - 3rem));
    margin: 6vh auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-elevated);
    color: var(--text);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6), 0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: rgba(5, 6, 12, 0.6);
    backdrop-filter: blur(6px);
  }

  .search-panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
  }

  .search-input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
  }

  .search-scopes {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
  }

  .search-scopes button {
    padding: 0.2rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-dim);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .search-scopes button[aria-pressed='true'] {
    color: var(--text);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem;
    overflow-y: auto;
    flex: 1;
  }

  .search-results li {
    padding: 0.7rem 0.8rem;
    border-radius: 10px;
    cursor: pointer;
  }

  .search-results li[aria-selected='true'] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .search-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-kind {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.05rem 0.45rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
  }

  .search-title {
    font-weight: 650;
  }

  .search-badge {
    margin-left: auto;
    font-size: 0.68rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--accent-2);
    color: var(--accent-2);
  }

  .search-section {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .search-snippet {
    margin-top: 0.25rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .search-dialog mark {
    background: color-mix(in srgb, var(--accent-2) 30%, transparent);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }

  .search-empty {
    padding: 0 1rem;
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .search-empty:not(:empty) {
    padding: 1.2rem 1rem 1.4rem;
  }

  .search-suggest {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .search-suggest button {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.84rem;
    cursor: pointer;
  }

  .search-suggest button:hover {
    border-color: var(--accent);
  }

  .search-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .search-hints kbd {
    margin-right: 0.2rem;
  }

  .search-banner:not(:empty) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 1rem;
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .search-back {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
  }

  .search-rel {
    margin-left: auto;
    width: 3.2rem;
    height: 4px;
    border-radius: 4px;
    background: var(--border);
    overflow: hidden;
    flex: none;
  }

  .search-rel i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }

  .search-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .search-match {
    font-size: 0.68rem;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-dim);
  }

  .search-match.meaning,
  .search-match.both {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .search-similar {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    opacity: 0;
  }

  .search-results li:hover .search-similar,
  .search-results li[aria-selected='true'] .search-similar {
    opacity: 1;
  }

  @media (hover: none) {
    .search-similar {
      opacity: 1;
    }
    .search-trigger .search-kbd {
      display: none;
    }
  }

  .search-empty p {
    margin: 0.2rem 0;
  }
</style>
